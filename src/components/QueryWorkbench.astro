---
const examples = [
  {
    id: "conversion",
    label: "Conversion",
    question: "Which email most often leads to a completed order?",
    cohort: "completed_order",
    append: "opened_email",
    relationship: "last before",
    result: "Group completed orders by the last email each customer opened before ordering.",
  },
  {
    id: "retention",
    label: "Retention",
    question: "What did retained customers do before renewing?",
    cohort: "renewed_subscription",
    append: "product_activity",
    relationship: "aggregate in before",
    result: "Summarize product activity before each renewal, without changing the cohort rows.",
  },
  {
    id: "operations",
    label: "Operations",
    question: "Where do orders wait longest before shipment?",
    cohort: "completed_order",
    append: "shipped_order",
    relationship: "first after",
    result: "Measure elapsed time from every completed order to its next shipment activity.",
  },
];
---

<figure class="workbench" data-workbench aria-labelledby="query-plan-title">
  <figcaption>
    <div>
      <strong id="query-plan-title">A question becomes a compact semantic plan</strong>
    </div>
    <div class="ready"><i></i><span>grounded in named activities</span></div>
  </figcaption>
  <div class="workbench-body">
    <div class="example-tabs" role="group" aria-label="Choose an example business question">
      {
        examples.map((example, index) => (
          <button type="button" data-example={example.id} aria-pressed={index === 0 ? "true" : "false"}>
            {example.label}
          </button>
        ))
      }
    </div>
    <div class="question-row">
      <span class="row-label mono">Question</span>
      <p class="prompt" data-question>{examples[0].question}</p>
    </div>
    <div class="plan" aria-live="polite">
      <div class="plan-step">
        <span class="step-number mono">01</span>
        <span class="step-label">Start with the outcome</span>
        <code data-cohort>{examples[0].cohort}</code>
      </div>
      <div class="connector" aria-hidden="true"><span></span><b>then</b><span></span></div>
      <div class="plan-step">
        <span class="step-number mono">02</span>
        <span class="step-label">Add useful context</span>
        <code data-append>{examples[0].append}</code>
      </div>
      <div class="connector" aria-hidden="true"><span></span><b>using</b><span></span></div>
      <div class="plan-step relationship-step">
        <span class="step-number mono">03</span>
        <span class="step-label">Name the relationship</span>
        <code data-relationship>{examples[0].relationship}</code>
      </div>
    </div>
    <div class="result">
      <span class="row-label mono">Inspectable result</span>
      <p data-result>{examples[0].result}</p>
    </div>
  </div>
</figure>

<script is:inline define:vars={{ examples }}>
  const root = document.querySelector("[data-workbench]");

  if (root) {
    const fields = {
      question: root.querySelector("[data-question]"),
      cohort: root.querySelector("[data-cohort]"),
      append: root.querySelector("[data-append]"),
      relationship: root.querySelector("[data-relationship]"),
      result: root.querySelector("[data-result]"),
    };

    root.querySelectorAll("[data-example]").forEach((button) => {
      button.addEventListener("click", () => {
        const selected = examples.find((example) => example.id === button.dataset.example);
        if (!selected) return;

        root.querySelectorAll("[data-example]").forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });

        Object.entries(fields).forEach(([key, element]) => {
          if (element) element.textContent = selected[key];
        });
      });
    });
  }
</script>

<style>
  .workbench { margin: 0; border-block: 1px solid var(--line); background: var(--white); }
  figcaption { display: flex; align-items: end; justify-content: space-between; gap: 32px; padding: 20px 0 24px; border-bottom: 1px solid var(--line); }
  figcaption > div:first-child { display: grid; gap: 6px; }
  figcaption strong { color: var(--navy); font-size: 1rem; }
  .ready { display: flex; align-items: center; gap: 8px; color: var(--seafoam-dark); font-size: 0.82rem; }
  .ready i { width: 18px; height: 2px; background: var(--seafoam); }
  .workbench-body { padding-block: clamp(24px, 5vw, 48px); }
  .example-tabs { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
  button { min-height: 38px; padding: 8px 14px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--steel); cursor: pointer; font: inherit; font-size: 0.84rem; }
  button[aria-pressed="true"] { border-color: var(--orange); color: var(--navy); font-weight: 600; }
  .question-row { display: grid; grid-template-columns: 110px 1fr; gap: 24px; align-items: baseline; margin-bottom: 48px; }
  .row-label { color: var(--fog); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .prompt { max-width: 760px; margin: 0; color: var(--navy); font-size: clamp(1.35rem, 3vw, 2.2rem); font-weight: 600; line-height: 1.15; letter-spacing: -0.03em; }
  .plan { display: grid; grid-template-columns: 1fr 72px 1fr 72px 1fr; align-items: stretch; }
  .plan-step { display: grid; min-height: 152px; grid-template-rows: auto 1fr auto; gap: 20px; padding: 18px 0; border-block: 1px solid var(--line); }
  .relationship-step { border-color: var(--seafoam); background: linear-gradient(90deg, rgba(68, 180, 139, 0.07), transparent); }
  .step-number { color: var(--orange); font-size: 0.75rem; }
  .step-label { align-self: end; color: var(--steel); font-size: 0.82rem; }
  .plan code { overflow-wrap: anywhere; color: var(--navy); font-size: 0.88rem; font-weight: 600; }
  .connector { display: grid; grid-template-columns: 1fr auto 1fr; justify-items: center; align-items: center; gap: 8px; }
  .connector span { width: 100%; height: 1px; background: var(--line); position: relative; }
  .connector span:last-child::after { position: absolute; right: 0; top: -3px; width: 6px; height: 6px; border-top: 1px solid var(--fog); border-right: 1px solid var(--fog); transform: rotate(45deg); content: ""; }
  .connector b { color: var(--fog); font-family: "SFMono-Regular", Consolas, monospace; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  .result { display: grid; grid-template-columns: 110px 1fr; gap: 24px; margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--line); }
  .result p { max-width: 760px; margin: 0; color: var(--slate); font-size: 0.95rem; }
  @media (max-width: 780px) {
    figcaption, .question-row, .result { grid-template-columns: 1fr; display: grid; gap: 10px; }
    .plan { grid-template-columns: 1fr; }
    .connector { height: 42px; grid-template-columns: 1fr; grid-template-rows: 1fr auto 1fr; }
    .connector span { align-self: end; width: 1px; height: 100%; }
    .connector span:last-child::after { right: -3px; top: auto; bottom: 0; border: 0; border-right: 1px solid var(--fog); border-bottom: 1px solid var(--fog); }
  }
</style>
