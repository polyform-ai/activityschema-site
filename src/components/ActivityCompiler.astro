---
const endpoint = import.meta.env.PUBLIC_ACTIVITY_SCHEMA_COMPILE_URL
  ?? "https://api.polyform.ai/activity-schema/compile";
---

<section class="compiler" data-compiler>
  <div class="compiler-head">
    <div>
      <span class="mono">LIVE COMPILER · INSPIRED BY POLYFORM’S DATASET TOOL</span>
      <h2>Describe the dataset. Get the SQL.</h2>
    </div>
    <div class="compiler-state" data-state><i></i><span>Ready</span></div>
  </div>

  <form class="compiler-form" data-form>
    <fieldset class="stream-fields">
      <legend>Warehouse and stream</legend>
      <label>Dialect
        <select name="dialect">
          <option value="snowflake">Snowflake</option>
          <option value="bigquery">BigQuery</option>
          <option value="redshift">Redshift</option>
          <option value="sqlserver">SQL Server</option>
          <option value="databricks">Databricks</option>
        </select>
      </label>
      <label>Storage layout
        <select name="layout">
          <option value="single_table">One stream table</option>
          <option value="activity_tables">One table per activity</option>
        </select>
      </label>
      <label>Schema <input name="schema" value="analytics" required pattern="[A-Za-z_][A-Za-z0-9_]*" /></label>
      <label>Stream table or prefix <input name="table" value="activity_stream" required pattern="[A-Za-z_][A-Za-z0-9_]*" /></label>
    </fieldset>

    <fieldset class="definition-row cohort-row" data-cohort>
      <legend><span class="row-icon mono">COHORT</span><strong>Start with</strong></legend>
      <div class="sentence-grid cohort-sentence">
        <label>Fetch
          <select name="cohortFetch">
            <option value="all">Every occurrence</option>
            <option value="first">First occurrence</option>
            <option value="last">Last occurrence</option>
          </select>
        </label>
        <span class="sentence-word">of</span>
        <label>Activity <input name="cohortActivity" value="completed_order" required pattern="[A-Za-z_][A-Za-z0-9_]*" /></label>
        <button class="refine-button" type="button" data-add-filter>Add filter</button>
      </div>
      <div class="filter-list" data-filter-list></div>
      <label class="columns-field">Columns <input name="cohortColumns" value="ts, activity_id, order_id" required pattern="[A-Za-z_][A-Za-z0-9_]*(,\s*[A-Za-z_][A-Za-z0-9_]*)*" /><small>Comma-separated standard columns or feature keys</small></label>
    </fieldset>

    <section class="append-section" aria-labelledby="append-heading">
      <div class="append-heading">
        <div><span class="mono">APPEND ACTIVITIES</span><h3 id="append-heading">Add context around every cohort row.</h3></div>
        <span class="append-count" data-append-count>1 of 8</span>
      </div>
      <div class="append-list" data-append-list></div>
      <button class="add-append" type="button" data-add-append><span aria-hidden="true">＋</span> Add another append source</button>
    </section>

    <div class="compiler-actions">
      <button class="button button-primary" type="submit">Compile query <span aria-hidden="true">→</span></button>
      <span>No account or warehouse connection required.</span>
    </div>
  </form>

  <div class="compiler-output">
    <div class="output-toolbar">
      <span class="mono">WAREHOUSE SQL</span>
      <button type="button" data-copy disabled>Copy SQL</button>
    </div>
    <pre><code data-sql>Choose a cohort, add one or more activities and filters, then compile.</code></pre>
    <div class="compiler-message" data-message aria-live="polite"></div>
  </div>

  <template data-append-template>
    <fieldset class="definition-row append-row" data-append>
      <legend><span class="row-icon mono">JOIN <b data-append-number>1</b></span><strong>Append activity</strong><button type="button" data-remove-append aria-label="Remove append activity">Remove</button></legend>
      <div class="sentence-grid append-sentence">
        <label>Fetch
          <select data-field="fetch">
            <option value="first">First</option>
            <option value="last">Last</option>
            <option value="all">All</option>
          </select>
        </label>
        <span class="sentence-word">activity</span>
        <label>Activity <input data-field="activity" value="shipped_order" required pattern="[A-Za-z_][A-Za-z0-9_]*" /></label>
        <span class="sentence-word">that is</span>
        <label>Relation
          <select data-field="relation">
            <option value="after">After</option>
            <option value="after_or_on">After or on</option>
            <option value="before">Before</option>
            <option value="before_or_on">Before or on</option>
            <option value="ever">Ever</option>
            <option value="in_between">In between</option>
          </select>
        </label>
        <button class="refine-button" type="button" data-add-filter>Add filter</button>
      </div>
      <div class="filter-list" data-filter-list></div>
      <label class="columns-field">Columns <input data-field="columns" value="ts, carrier" required pattern="[A-Za-z_][A-Za-z0-9_]*(,\s*[A-Za-z_][A-Za-z0-9_]*)*" /><small>Comma-separated standard columns or feature keys</small></label>
    </fieldset>
  </template>

  <template data-filter-template>
    <div class="filter-row" data-filter>
      <span class="filter-prefix mono">WHERE</span>
      <label>Column <input data-filter-field="column" value="country" required pattern="[A-Za-z_][A-Za-z0-9_]*" /></label>
      <label>Type
        <select data-filter-field="type">
          <option value="string">Text</option>
          <option value="number">Number</option>
          <option value="boolean">True / false</option>
          <option value="timestamp">Timestamp</option>
        </select>
      </label>
      <label>Operator
        <select data-filter-field="operator">
          <option value="equal">Equals</option>
          <option value="not_equal">Does not equal</option>
          <option value="is_null">Is empty</option>
          <option value="is_not_null">Is not empty</option>
        </select>
      </label>
      <label>Value <input data-filter-field="value" value="US" required /></label>
      <button type="button" data-remove-filter aria-label="Remove filter">×</button>
    </div>
  </template>
</section>

<script is:inline define:vars={{ endpoint }}>
  const root = document.querySelector("[data-compiler]");

  if (root) {
    const form = root.querySelector("[data-form]");
    const sql = root.querySelector("[data-sql]");
    const message = root.querySelector("[data-message]");
    const state = root.querySelector("[data-state] span");
    const copy = root.querySelector("[data-copy]");
    const appendList = root.querySelector("[data-append-list]");
    const appendTemplate = root.querySelector("[data-append-template]");
    const filterTemplate = root.querySelector("[data-filter-template]");
    const appendCount = root.querySelector("[data-append-count]");
    const addAppendButton = root.querySelector("[data-add-append]");
    const MAX_APPENDS = 8;
    const MAX_FILTERS = 12;

    const setState = (label, kind = "ready") => {
      if (state) state.textContent = label;
      root.dataset.status = kind;
    };

    const operatorOptions = {
      string: [["equal", "Equals"], ["not_equal", "Does not equal"], ["is_null", "Is empty"], ["is_not_null", "Is not empty"]],
      number: [["equal", "Equals"], ["not_equal", "Does not equal"], ["greater_than", "Greater than"], ["greater_than_equal", "At least"], ["less_than", "Less than"], ["less_than_equal", "At most"], ["is_null", "Is empty"], ["is_not_null", "Is not empty"]],
      boolean: [["equal", "Equals"], ["not_equal", "Does not equal"], ["is_null", "Is empty"], ["is_not_null", "Is not empty"]],
      timestamp: [["equal", "Equals"], ["not_equal", "Does not equal"], ["greater_than", "After"], ["greater_than_equal", "On or after"], ["less_than", "Before"], ["less_than_equal", "On or before"], ["is_null", "Is empty"], ["is_not_null", "Is not empty"]],
    };

    const updateFilterOperators = (filter) => {
      const type = filter.querySelector('[data-filter-field="type"]')?.value || "string";
      const operator = filter.querySelector('[data-filter-field="operator"]');
      const value = filter.querySelector('[data-filter-field="value"]');
      if (!(operator instanceof HTMLSelectElement)) return;
      const previous = operator.value;
      operator.replaceChildren(...operatorOptions[type].map(([optionValue, label]) => {
        const option = document.createElement("option");
        option.value = optionValue;
        option.textContent = label;
        return option;
      }));
      if ([...operator.options].some((option) => option.value === previous)) operator.value = previous;
      if (value instanceof HTMLInputElement) {
        const needsValue = !["is_null", "is_not_null"].includes(operator.value);
        value.disabled = !needsValue;
        value.required = needsValue;
        value.type = type === "number" ? "number" : "text";
        if (type === "boolean") value.pattern = "true|false";
        else value.removeAttribute("pattern");
        value.placeholder = type === "boolean"
          ? "true or false"
          : type === "timestamp"
            ? "2026-08-23T12:00:00Z"
            : "Value";
      }
    };

    const addFilter = (scope) => {
      if (!(filterTemplate instanceof HTMLTemplateElement)) return;
      if (scope.querySelectorAll("[data-filter]").length >= MAX_FILTERS) return;
      const filter = filterTemplate.content.firstElementChild?.cloneNode(true);
      if (!(filter instanceof HTMLElement)) return;
      scope.querySelector("[data-filter-list]")?.append(filter);
      filter.querySelector('[data-filter-field="type"]')?.addEventListener("change", () => updateFilterOperators(filter));
      filter.querySelector('[data-filter-field="operator"]')?.addEventListener("change", () => updateFilterOperators(filter));
      filter.querySelector("[data-remove-filter]")?.addEventListener("click", () => filter.remove());
      updateFilterOperators(filter);
    };

    const refreshAppendState = () => {
      const appends = [...root.querySelectorAll("[data-append]")];
      appends.forEach((append, index) => {
        const number = append.querySelector("[data-append-number]");
        if (number) number.textContent = String(index + 1);
      });
      if (appendCount) appendCount.textContent = `${appends.length} of ${MAX_APPENDS}`;
      if (addAppendButton instanceof HTMLButtonElement) addAppendButton.disabled = appends.length >= MAX_APPENDS;
    };

    const addAppend = (defaults = {}) => {
      if (!(appendTemplate instanceof HTMLTemplateElement) || !appendList) return;
      if (root.querySelectorAll("[data-append]").length >= MAX_APPENDS) return;
      const append = appendTemplate.content.firstElementChild?.cloneNode(true);
      if (!(append instanceof HTMLElement)) return;
      appendList.append(append);
      const activity = append.querySelector('[data-field="activity"]');
      const columns = append.querySelector('[data-field="columns"]');
      if (activity instanceof HTMLInputElement && defaults.activity) activity.value = defaults.activity;
      if (columns instanceof HTMLInputElement && defaults.columns) columns.value = defaults.columns;
      append.querySelector("[data-add-filter]")?.addEventListener("click", () => addFilter(append));
      append.querySelector("[data-remove-append]")?.addEventListener("click", () => {
        append.remove();
        refreshAppendState();
      });
      refreshAppendState();
    };

    root.querySelector("[data-cohort] [data-add-filter]")?.addEventListener("click", () => {
      const cohort = root.querySelector("[data-cohort]");
      if (cohort) addFilter(cohort);
    });
    addAppendButton?.addEventListener("click", () => addAppend({ activity: "refunded_order", columns: "ts, reason" }));
    addAppend({ activity: "shipped_order", columns: "ts, carrier" });

    const columnNames = (value) => String(value || "")
      .split(",")
      .map((name) => name.trim())
      .filter(Boolean);
    const columnType = (name) => name === "ts"
      ? "timestamp"
      : name === "revenue_impact"
        ? "number"
        : "string";
    const aliasBase = (activity, name) => name === "ts"
      ? `${activity}_at`
      : name === "activity_id"
        ? `${activity}_id`
        : `${activity}_${name}`;

    const buildFilters = (scope) => [...scope.querySelectorAll("[data-filter]")].map((filter) => {
      const read = (field) => filter.querySelector(`[data-filter-field="${field}"]`)?.value || "";
      const type = read("type");
      const operator = read("operator");
      const rawValue = read("value");
      return {
        column: read("column"),
        type,
        operator,
        value: ["is_null", "is_not_null"].includes(operator)
          ? null
          : type === "number"
            ? Number(rawValue)
            : type === "boolean"
              ? rawValue.toLowerCase() === "true"
              : rawValue,
      };
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !(sql instanceof HTMLElement)) return;

      const values = new FormData(form);
      const cohortActivity = String(values.get("cohortActivity") || "");
      const usedAliases = new Set();
      const compileColumns = (value, activity, role) => columnNames(value).map((name) => {
        const base = aliasBase(activity, name);
        const alias = usedAliases.has(base) ? `${activity}_${role}_${name}` : base;
        usedAliases.add(alias);
        return { name, alias, type: columnType(name) };
      });
      const cohort = root.querySelector("[data-cohort]");
      const appends = [...root.querySelectorAll("[data-append]")].map((append, index) => {
        const read = (field) => append.querySelector(`[data-field="${field}"]`)?.value || "";
        const activity = read("activity");
        return {
          key: `${activity}_${index + 1}`,
          activity,
          fetch: read("fetch"),
          relation: read("relation"),
          columns: compileColumns(read("columns"), activity, `append_${index + 1}`),
          filters: buildFilters(append),
        };
      });
      const request = {
        version: "3",
        dialect: values.get("dialect"),
        stream: {
          entity: "customer",
          schema: values.get("schema"),
          table: values.get("table"),
          layout: values.get("layout"),
        },
        cohort: {
          activity: cohortActivity,
          fetch: values.get("cohortFetch"),
          columns: compileColumns(values.get("cohortColumns"), cohortActivity, "cohort"),
          filters: cohort ? buildFilters(cohort) : [],
        },
        appends,
      };

      setState("Compiling…", "loading");
      sql.textContent = "Compiling the Activity Schema query…";
      if (message) message.textContent = "";
      if (copy instanceof HTMLButtonElement) copy.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(request),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload?.sql) {
          const detail = payload?.detail;
          const label = typeof detail === "string"
            ? detail
            : Array.isArray(detail)
              ? detail.map((item) => item.msg || "Invalid query input").join(" · ")
              : "The public compiler is not available yet. Try again after the Polyform backend release.";
          throw new Error(label);
        }
        sql.textContent = payload.sql;
        const explanation = Array.isArray(payload.explanation) ? payload.explanation.join(" ") : "";
        const warnings = Array.isArray(payload.warnings) && payload.warnings.length
          ? ` Warnings: ${payload.warnings.join(" ")}`
          : "";
        if (message) message.textContent = `${explanation}${warnings}`.trim();
        if (copy instanceof HTMLButtonElement) copy.disabled = false;
        setState("Compiled", "success");
      } catch (error) {
        sql.textContent = "No SQL was generated.";
        const errorMessage = error instanceof Error ? error.message : "";
        if (message) message.textContent = errorMessage === "Failed to fetch"
          ? "The public compiler is not available yet. Try again after the Polyform backend release."
          : errorMessage || "The compiler request failed.";
        setState("Unavailable", "error");
      }
    });

    copy?.addEventListener("click", async () => {
      if (!(sql instanceof HTMLElement) || !navigator.clipboard) return;
      await navigator.clipboard.writeText(sql.textContent || "");
      if (copy instanceof HTMLButtonElement) copy.textContent = "Copied";
      window.setTimeout(() => {
        if (copy instanceof HTMLButtonElement) copy.textContent = "Copy SQL";
      }, 1400);
    });
  }
</script>

<style>
  .compiler { border: 1px solid var(--line); background: var(--white); }
  .compiler-head { display: flex; align-items: end; justify-content: space-between; gap: 32px; padding: clamp(24px, 5vw, 44px); border-bottom: 1px solid var(--line); }
  .compiler-head > div:first-child > span, .output-toolbar > span { color: var(--orange); font-size: .63rem; letter-spacing: .12em; }
  .compiler-head h2 { max-width: 820px; margin: 10px 0 0; font-size: clamp(2rem, 4.3vw, 4rem); }
  .compiler-state { display: flex; align-items: center; gap: 8px; color: var(--seafoam-dark); font-size: .75rem; }
  .compiler-state i { width: 18px; height: 2px; background: var(--seafoam); }
  [data-status="loading"] .compiler-state i { background: var(--orange); }
  [data-status="error"] .compiler-state { color: var(--orange); }
  [data-status="error"] .compiler-state i { background: var(--orange); }
  .compiler-form { padding: clamp(24px, 5vw, 44px); }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .stream-fields { display: grid; grid-template-columns: .9fr 1.15fr 1fr 1.45fr; gap: 16px; padding-bottom: 34px; border-bottom: 1px solid var(--line); }
  legend { margin-bottom: 18px; color: var(--navy); font-weight: 600; }
  .stream-fields legend { grid-column: 1 / -1; }
  label { display: grid; gap: 7px; color: var(--steel); font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; }
  label small { color: var(--steel); font-size: .61rem; font-weight: 400; letter-spacing: 0; text-transform: none; }
  input, select { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 0; background: var(--white); color: var(--navy); font: 500 .82rem "SFMono-Regular", Consolas, monospace; }
  input:focus, select:focus { border-color: var(--seafoam-dark); outline: 2px solid rgba(68,180,139,.15); }
  .definition-row { display: grid; gap: 18px; margin-top: 22px; padding: 24px; border: 1px solid var(--line); background: var(--canvas); }
  .definition-row legend { display: flex; width: 100%; align-items: center; gap: 12px; margin: 0; }
  .definition-row legend strong { font-size: .92rem; }
  .definition-row legend button { margin-left: auto; padding: 0; border: 0; background: transparent; color: var(--steel); cursor: pointer; font-family: inherit; font-size: .68rem; }
  .row-icon { color: var(--orange); font-size: .62rem; letter-spacing: .1em; }
  .append-row .row-icon { color: var(--seafoam-dark); }
  .sentence-grid { display: grid; align-items: end; gap: 12px; }
  .cohort-sentence { grid-template-columns: minmax(145px,.75fr) auto minmax(230px,1.5fr) auto; }
  .append-sentence { grid-template-columns: minmax(120px,.65fr) auto minmax(210px,1.35fr) auto minmax(145px,.8fr) auto; }
  .sentence-word { align-self: center; padding-top: 19px; color: var(--steel); font-size: .82rem; }
  .refine-button, .add-append { min-height: 44px; padding: 10px 14px; border: 1px dashed var(--seafoam-dark); background: transparent; color: var(--seafoam-dark); cursor: pointer; font-family: inherit; font-size: .72rem; font-weight: 600; }
  .refine-button::before { content: "+ "; }
  .columns-field { padding-top: 16px; border-top: 1px solid var(--line); }
  .filter-list { display: grid; gap: 8px; }
  .filter-list:empty { display: none; }
  .filter-row { display: grid; grid-template-columns: auto minmax(120px,1fr) minmax(100px,.65fr) minmax(130px,.8fr) minmax(120px,1fr) auto; gap: 8px; align-items: end; padding-top: 14px; border-top: 1px solid var(--line); }
  .filter-prefix { align-self: center; color: var(--orange); font-size: .6rem; }
  .filter-row > button { align-self: end; width: 44px; height: 44px; border: 1px solid var(--line); background: var(--white); color: var(--orange); cursor: pointer; font-size: 1.15rem; }
  .append-section { margin-top: 38px; }
  .append-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
  .append-heading span { color: var(--orange); font-size: .62rem; letter-spacing: .1em; }
  .append-heading h3 { margin: 8px 0 0; font-size: 1.45rem; }
  .append-heading .append-count { color: var(--steel); }
  .append-list { display: grid; gap: 14px; }
  .add-append { margin-top: 14px; border-color: var(--line); color: var(--navy); }
  .add-append:disabled { cursor: default; opacity: .4; }
  .compiler-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 32px; }
  .compiler-actions .button { cursor: pointer; }
  .compiler-actions > span { color: var(--steel); font-size: .78rem; }
  .compiler-output { background: var(--midnight); color: var(--white); }
  .output-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .output-toolbar button { padding: 6px 0; border: 0; background: transparent; color: var(--seafoam-light); cursor: pointer; font-family: inherit; font-size: .72rem; font-weight: 600; }
  .output-toolbar button:disabled { color: rgba(255,255,255,.28); cursor: default; }
  .compiler-output pre { min-height: 240px; max-height: 560px; overflow: auto; margin: 0; padding: 26px; white-space: pre; }
  .compiler-output code { color: var(--seafoam-light); font-size: .78rem; line-height: 1.65; }
  .compiler-message { min-height: 48px; padding: 14px 22px; border-top: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.64); font-size: .78rem; }
  @media (max-width: 1020px) {
    .sentence-grid, .filter-row { grid-template-columns: 1fr 1fr; }
    .sentence-word { display: none; }
    .refine-button { width: fit-content; }
    .filter-prefix { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .compiler-head { display: grid; }
    .stream-fields, .sentence-grid, .filter-row { grid-template-columns: 1fr; }
    .stream-fields legend, .filter-prefix { grid-column: auto; }
    .definition-row { padding: 18px; }
    .append-heading { align-items: start; }
  }
</style>
