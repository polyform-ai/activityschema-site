---
const rows = [
  { index: "01", time: "09:04", customer: "cus_102", activity: "started_session", feature: "source · organic", focus: true },
  { index: "02", time: "09:11", customer: "cus_102", activity: "viewed_pricing", feature: "plan · growth", focus: true },
  { index: "03", time: "09:18", customer: "cus_381", activity: "opened_email", feature: "campaign · welcome", focus: false },
  { index: "04", time: "09:26", customer: "cus_102", activity: "started_trial", feature: "plan · growth", focus: true },
  { index: "05", time: "09:41", customer: "cus_381", activity: "completed_order", feature: "revenue · 240", focus: false },
];
---

<figure class="stream-figure" aria-labelledby="stream-title" aria-describedby="stream-description">
  <figcaption>
    <div>
      <strong id="stream-title">An activity stream is an event ledger</strong>
    </div>
    <p id="stream-description">Every row answers the same four questions: when, who, what happened, and what context came with it.</p>
  </figcaption>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">Sequence</span></th>
          <th scope="col">when</th>
          <th scope="col">who</th>
          <th scope="col">what happened</th>
          <th scope="col">event context</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class:list={{ focus: row.focus }}>
            <td><span class="row-index mono">{row.index}</span></td>
            <td><time>{row.time}</time></td>
            <td><code>{row.customer}</code></td>
            <td><strong>{row.activity}</strong></td>
            <td><span class="feature mono">{row.feature}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="contract" aria-label="The four-part activity contract">
    <span><b>ts</b><small>when</small></span>
    <i aria-hidden="true">+</i>
    <span><b>customer</b><small>who</small></span>
    <i aria-hidden="true">+</i>
    <span><b>activity</b><small>what</small></span>
    <i aria-hidden="true">+</i>
    <span><b>features</b><small>context</small></span>
  </div>
</figure>

<style>
  .stream-figure {
    width: 100%;
    min-width: 0;
    margin: 0;
    border-block: 1px solid var(--line);
    background: var(--white);
  }

  figcaption {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 0.75fr);
    gap: 40px;
    align-items: end;
    padding: 20px 20px 24px;
    border-bottom: 1px solid var(--line);
  }

  figcaption > div {
    display: grid;
    gap: 6px;
  }

  figcaption strong {
    color: var(--navy);
    font-size: 1.05rem;
    font-weight: 600;
  }

  figcaption p {
    margin: 0;
    color: var(--steel);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    text-align: left;
  }

  th,
  td {
    padding: 15px 18px;
    border-bottom: 1px solid #eceef1;
    white-space: nowrap;
  }

  th {
    color: var(--fog);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  td {
    color: var(--slate);
    font-size: 0.9rem;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody tr.focus {
    background: linear-gradient(90deg, rgba(68, 180, 139, 0.07), transparent 70%);
  }

  tbody tr.focus td:first-child {
    box-shadow: inset 2px 0 var(--seafoam);
  }

  .row-index {
    color: var(--fog);
    font-size: 0.75rem;
  }

  td code,
  .feature {
    font-size: 0.82rem;
  }

  td strong {
    color: var(--navy);
    font-weight: 600;
  }

  .contract {
    display: grid;
    grid-template-columns: repeat(7, auto);
    justify-content: start;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border-top: 1px solid var(--line);
    background: var(--canvas);
  }

  .contract span {
    display: grid;
    gap: 2px;
  }

  .contract b {
    color: var(--navy);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .contract small,
  .contract i {
    color: var(--fog);
    font-size: 0.75rem;
    font-style: normal;
  }

  @media (max-width: 640px) {
    figcaption {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-inline: 0;
    }

    .contract {
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
      padding-inline: 0;
    }

    .contract i {
      display: none;
    }
  }
</style>
