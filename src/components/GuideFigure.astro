---
interface Props {
  id: string;
  title: string;
  description: string;
}

const { id, title, description } = Astro.props;
---

<figure class="guide-figure" aria-labelledby={`${id}-caption`}>
  <figcaption id={`${id}-caption`}>
    <p><strong>{title}</strong> {description}</p>
  </figcaption>
  <div class="diagram-scroll">
    <slot />
  </div>
</figure>

<style>
  .guide-figure {
    margin: 0;
    border-block: 1px solid var(--line);
    background: var(--white);
  }

  figcaption {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  figcaption p {
    max-width: 680px;
    margin: 0;
    color: var(--steel);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  figcaption strong {
    color: var(--navy);
  }

  .diagram-scroll {
    overflow-x: auto;
  }

  .diagram-scroll :global(svg) {
    min-width: 1040px;
    font-family: Inter, ui-sans-serif, sans-serif;
  }
</style>
