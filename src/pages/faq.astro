---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqCategories, faqItems } from "../data/faq";

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteHref = (href: string) => href.startsWith('/') ? `${basePath}${href.replace(/^\/+/, '')}` : href;
const faqHref = (fragment: string) => siteHref(`/faq/#${fragment}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `${item.answer}${item.detail ? ` ${item.detail}` : ''}`,
    },
  })),
}
---

<BaseLayout
  title="Activity Schema FAQ"
  description="Direct answers to common questions about Activity Schema, temporal joins, schema on read, BI tools, identity resolution, efficiency, implementation, and AI."
  path="/faq/"
  schema={schema}
>
  <header class="page-hero shell">
    <p class="eyebrow">Frequently asked questions</p>
    <h1>Start with the question you actually have.</h1>
    <p class="lede">Short answers to the questions that appear when people model, query, implement, or evaluate Activity Schema. Every deeper guide and specification link stays close to the answer it supports.</p>
  </header>

  <section class="section-tight faq-controls-section">
    <div class="shell faq-controls" data-faq-controls>
      <label for="faq-search">Search all questions</label>
      <input id="faq-search" type="search" placeholder="Try “BI tools”, “identity”, or “cohort”" autocomplete="off" data-faq-search />
      <div class="category-list" role="group" aria-label="Filter questions by category">
        <button type="button" data-category="all" aria-pressed="true">All <span>{faqItems.length}</span></button>
        {faqCategories.map((category) => (
          <button type="button" data-category={category} aria-pressed="false">{category} <span>{faqItems.filter((item) => item.category === category).length}</span></button>
        ))}
      </div>
      <p class="result-count" aria-live="polite" data-faq-count>{faqItems.length} questions</p>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell faq-layout">
      <aside>
        <p class="eyebrow">Browse</p>
        <nav aria-label="FAQ categories">
          {faqCategories.map((category) => <a href={faqHref(category.toLowerCase().replaceAll(' ', '-'))}>{category}</a>)}
        </nav>
      </aside>
      <div class="faq-groups" data-faq-groups>
        {faqCategories.map((category) => (
          <section class="faq-group" id={category.toLowerCase().replaceAll(' ', '-')} data-faq-group>
            <header><span class="mono">{String(faqCategories.indexOf(category) + 1).padStart(2, '0')}</span><h2>{category}</h2></header>
            <div class="question-list">
              {faqItems.filter((item) => item.category === category).map((item) => (
                <details id={item.id} data-faq-item data-category={item.category}>
                  <summary>{item.question}<span aria-hidden="true">+</span></summary>
                  <div class="answer">
                    <p class="direct-answer">{item.answer}</p>
                    {item.detail && <p>{item.detail}</p>}
                    {item.href && <a href={siteHref(item.href)}>{item.linkLabel ?? 'Learn more'} <span aria-hidden="true">→</span></a>}
                    <a class="anchor-link" href={faqHref(item.id)}>Link to this answer</a>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
        <div class="no-results" hidden data-no-results>
          <h2>No matching question yet.</h2>
          <p>Send the question and it can become part of this living reference.</p>
          <a class="button button-primary" href="mailto:ahmed@polyform.ai?subject=Activity%20Schema%20question">Ask Ahmed <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const search = document.querySelector('[data-faq-search]');
    const categoryButtons = Array.from(document.querySelectorAll('[data-category]'));
    const items = Array.from(document.querySelectorAll('[data-faq-item]'));
    const groups = Array.from(document.querySelectorAll('[data-faq-group]'));
    const count = document.querySelector('[data-faq-count]');
    const noResults = document.querySelector('[data-no-results]');
    let activeCategory = 'all';

    const applyFilters = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      let visibleCount = 0;
      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const categoryMatch = activeCategory === 'all' || item.dataset.category === activeCategory;
        const textMatch = !query || item.textContent?.toLowerCase().includes(query);
        item.hidden = !(categoryMatch && textMatch);
        if (!item.hidden) visibleCount += 1;
      });
      groups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        group.hidden = !group.querySelector('[data-faq-item]:not([hidden])');
      });
      if (count) count.textContent = `${visibleCount} question${visibleCount === 1 ? '' : 's'}`;
      if (noResults instanceof HTMLElement) noResults.hidden = visibleCount !== 0;
    };

    categoryButtons.forEach((button) => button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      activeCategory = button.dataset.category ?? 'all';
      categoryButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      applyFilters();
    }));
    search?.addEventListener('input', applyFilters);

    if (window.location.hash) {
      const target = document.querySelector(window.location.hash);
      if (target instanceof HTMLDetailsElement) target.open = true;
    }
  </script>
</BaseLayout>

<style>
  .faq-controls-section { border-block: 1px solid var(--line); background: var(--white); }
  .faq-controls { display: grid; gap: 18px; }
  .faq-controls label { color: var(--navy); font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .faq-controls input { width: 100%; min-height: 62px; padding: 14px 18px; border: 1px solid var(--fog); border-radius: var(--radius); background: var(--canvas); color: var(--navy); font: inherit; font-size: 1.05rem; }
  .category-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .category-list button { padding: 9px 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); color: var(--slate); cursor: pointer; font: inherit; font-size: .76rem; }
  .category-list button[aria-pressed="true"] { border-color: var(--navy); background: var(--navy); color: var(--white); }
  .category-list span { margin-left: 5px; color: var(--fog); font-family: "SFMono-Regular", Consolas, monospace; font-size: .64rem; }
  .result-count { margin: 0; color: var(--steel); font-size: .8rem; }
  .faq-layout { display: grid; grid-template-columns: 220px minmax(0, 820px); justify-content: space-between; gap: 72px; }
  aside { position: sticky; top: 106px; align-self: start; }
  aside nav { display: grid; border-top: 1px solid var(--line); }
  aside nav a { padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--steel); font-size: .82rem; text-decoration: none; }
  aside nav a:hover { color: var(--navy); }
  .faq-groups { display: grid; gap: 88px; }
  .faq-group { scroll-margin-top: 100px; }
  .faq-group > header { display: grid; grid-template-columns: 52px 1fr; align-items: baseline; gap: 12px; margin-bottom: 28px; }
  .faq-group > header span { color: var(--orange); font-size: .68rem; }
  .faq-group h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); }
  .question-list { border-top: 1px solid var(--line); }
  details { scroll-margin-top: 96px; border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; padding: 24px 0; color: var(--navy); cursor: pointer; font-size: 1.06rem; font-weight: 600; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--orange); font-size: 1.2rem; font-weight: 400; transition: transform 160ms ease; }
  details[open] summary span { transform: rotate(45deg); }
  .answer { max-width: 700px; padding: 0 0 28px; }
  .answer p { font-size: .98rem; line-height: 1.7; }
  .answer .direct-answer { color: var(--navy); font-size: 1.08rem; font-weight: 600; }
  .answer a { display: inline-block; margin: 4px 18px 0 0; color: var(--seafoam-dark); font-size: .84rem; font-weight: 600; }
  .answer .anchor-link { color: var(--steel); font-weight: 400; }
  .no-results { padding: 48px; border: 1px solid var(--line); background: var(--white); }
  @media (max-width: 820px) { .faq-layout { grid-template-columns: 1fr; gap: 48px; } aside { position: static; } aside nav { grid-template-columns: repeat(2, 1fr); column-gap: 20px; } }
  @media (max-width: 520px) { aside nav { grid-template-columns: 1fr; } .faq-group > header { grid-template-columns: 1fr; } summary { font-size: 1rem; } }
</style>
