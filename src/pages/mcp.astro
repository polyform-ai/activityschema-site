---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActivityCompiler from "../components/ActivityCompiler.astro";

const mcpUrl = "https://api.polyform.ai/activity-schema/mcp";
const compileUrl = "https://api.polyform.ai/activity-schema/compile";
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteHref = (href: string) => `${basePath}${href.replace(/^\/+/, "")}`;
---

<BaseLayout
  title="Activity Schema MCP — Compile temporal queries into SQL"
  description="Connect a free, unauthenticated MCP server that turns Activity Schema V3 cohort, fetch, relation, join, and dimension plans into warehouse SQL."
  path="/mcp/"
>
  <header class="page-hero shell mcp-hero">
    <p class="eyebrow">Free public compiler · Built by Polyform</p>
    <h1>Give your AI a temporal SQL compiler.</h1>
    <p class="lede">Activity Schema MCP turns a structured cohort-and-append plan into warehouse SQL. <strong>No account. No warehouse credentials. No query execution.</strong></p>
    <div class="actions">
      <a class="button button-primary" href={siteHref("/mcp/#connect")}>Connect the MCP <span class="arrow" aria-hidden="true">↓</span></a>
      <a class="button button-secondary" href={siteHref("/mcp/#compiler")}>Try the compiler</a>
    </div>
  </header>

  <section class="section-tight promise-section">
    <div class="shell promise-grid">
      <div><span class="mono">01</span><h3>Describe</h3><p>Choose the cohort, then add as many append activities and typed filters as the question needs.</p></div>
      <div><span class="mono">02</span><h3>Validate</h3><p>The server checks identifiers and combinations against a constrained Activity Schema V3 contract.</p></div>
      <div><span class="mono">03</span><h3>Compile</h3><p>Receive SQL for your warehouse, along with an explanation, output columns, and warnings.</p></div>
    </div>
  </section>

  <section class="section compiler-section" id="compiler">
    <div class="shell"><ActivityCompiler /></div>
  </section>

  <section class="section connect-section" id="connect">
    <div class="shell connect-grid">
      <div class="connect-intro">
        <p class="eyebrow">Connect once</p>
        <h2>One URL. One read-only tool.</h2>
        <p class="lede">The remote server exposes <code>compile_activity_schema</code>. It is stateless and unauthenticated because it only compiles a declarative plan into text.</p>
        <div class="endpoint-card">
          <span class="mono">STREAMABLE HTTP</span>
          <code>{mcpUrl}</code>
          <button type="button" data-copy-value={mcpUrl}>Copy URL</button>
        </div>
      </div>
      <div class="setup-list">
        <section>
          <span class="setup-label mono">CODEX</span>
          <h3>Add with the CLI</h3>
          <pre><code>codex mcp add activity-schema --url {mcpUrl}</code></pre>
          <p>Then open <code>/mcp</code> in Codex to confirm that Activity Schema is connected.</p>
        </section>
        <section>
          <span class="setup-label mono">CLAUDE CODE</span>
          <h3>Add with the CLI</h3>
          <pre><code>claude mcp add --transport http activity-schema {mcpUrl}</code></pre>
        </section>
        <section>
          <span class="setup-label mono">OTHER MCP CLIENTS</span>
          <h3>Use Streamable HTTP</h3>
          <p>Name the server <code>activity-schema</code>, choose Streamable HTTP, and paste the URL above. Leave authentication empty.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="section contract-section">
    <div class="shell contract-grid">
      <div>
        <p class="eyebrow">The tool contract</p>
        <h2>Structured enough to trust. Small enough to understand.</h2>
        <p class="lede">The MCP host can translate a natural-language question into this contract. The compiler accepts identifiers and typed choices—not arbitrary SQL fragments. Filters within each activity are combined with AND.</p>
        <p>Post this object directly to the HTTP endpoint. MCP clients pass the same object as the tool’s <code>request</code> argument.</p>
      </div>
      <div class="contract-code">
        <div><span class="mono">TOOL</span><code>compile_activity_schema</code></div>
        <pre><code>{`{
  "version": "3",
  "dialect": "snowflake",
  "stream": {
    "entity": "customer",
    "schema": "analytics",
    "table": "activity_stream",
    "layout": "single_table"
  },
  "cohort": {
    "activity": "completed_order",
    "fetch": "all",
    "filters": [{
      "column": "country",
      "type": "string",
      "operator": "equal",
      "value": "US"
    }],
    "columns": [
      { "name": "ts", "alias": "ordered_at", "type": "timestamp" }
    ]
  },
  "appends": [{
    "key": "shipment",
    "activity": "shipped_order",
    "fetch": "first",
    "relation": "after",
    "filters": [{
      "column": "carrier",
      "type": "string",
      "operator": "not_equal",
      "value": "test"
    }],
    "columns": [
      { "name": "ts", "alias": "shipped_at", "type": "timestamp" }
    ]
  }, {
    "key": "refund",
    "activity": "refunded_order",
    "fetch": "first",
    "relation": "after",
    "columns": [
      { "name": "ts", "alias": "refunded_at", "type": "timestamp" },
      { "name": "reason", "alias": "refund_reason", "type": "string" }
    ]
  }]
}`}</code></pre>
      </div>
    </div>
  </section>

  <section class="section boundary-section">
    <div class="shell boundary-grid">
      <div>
        <span class="mono">WHAT IT DOES</span>
        <ul>
          <li>Compiles cohort fetches: first, last, or all.</li>
          <li>Reads one stream table or a table per activity.</li>
          <li>Compiles every append’s fetch and relation separately.</li>
          <li>Supports up to eight append sources and twelve AND filters per activity in the visual builder.</li>
          <li>Supports strict and inclusive temporal boundaries.</li>
          <li>Supports direct joins and time-valid dimensions.</li>
          <li>Returns SQL, output columns, explanations, and warnings.</li>
        </ul>
      </div>
      <div>
        <span class="mono">WHAT IT DOES NOT DO</span>
        <ul>
          <li>It does not connect to a warehouse.</li>
          <li>It does not run the generated SQL.</li>
          <li>It does not inspect private schemas or data.</li>
          <li>It does not replace validation of business definitions.</li>
          <li>It does not accept executable SQL fragments as input.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section api-section">
    <div class="shell api-grid">
      <div>
        <p class="eyebrow">Not using MCP?</p>
        <h2>Call the same compiler directly.</h2>
        <p>The global HTTP endpoint uses the same request and response contract as the MCP tool.</p>
      </div>
      <div class="endpoint-card api-endpoint">
        <span class="mono">POST</span>
        <code>{compileUrl}</code>
        <button type="button" data-copy-value={compileUrl}>Copy URL</button>
      </div>
    </div>
  </section>

  <section class="section built-section">
    <div class="shell built-card">
      <div>
        <p class="eyebrow">Why Polyform built it</p>
        <h2>Open the grammar. Keep the hard work visible.</h2>
        <p>Polyform uses Activity Schema to build maintained analytics and automation systems. The compiler opens the reusable query grammar to everyone. Production trust still depends on defining the right activities, resolving identity, testing results, managing permissions, and keeping business meaning current.</p>
      </div>
      <div class="actions">
        <a class="button button-primary" href={siteHref("/v3/")}>Read the V3 proposal <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="https://polyform.ai">Learn about Polyform <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="https://github.com/bcodell/dbt-activity-schema">See the dbt proof of concept <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll("[data-copy-value]").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!(button instanceof HTMLButtonElement) || !navigator.clipboard) return;
      await navigator.clipboard.writeText(button.dataset.copyValue || "");
      const original = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => { button.textContent = original; }, 1400);
    });
  });
</script>

<style>
  .mcp-hero h1 { max-width: 1080px; }
  .promise-section { border-block: 1px solid var(--line); background: var(--white); }
  .promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .promise-grid > div { padding: 34px; border-left: 1px solid var(--line); }
  .promise-grid > div:last-child { border-right: 1px solid var(--line); }
  .promise-grid span { color: var(--orange); font-size: .64rem; }
  .promise-grid h3 { margin-top: 28px; }
  .promise-grid p { margin: 0; font-size: .88rem; }
  .compiler-section { background: var(--canvas); }
  .connect-section { background: var(--white); }
  .connect-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(48px, 8vw, 110px); }
  .connect-grid > *, .contract-grid > * { min-width: 0; }
  .endpoint-card { display: grid; gap: 14px; margin-top: 38px; padding: 20px; border: 1px solid var(--line); background: var(--canvas); }
  .endpoint-card > span { color: var(--orange); font-size: .62rem; }
  .endpoint-card code { overflow-wrap: anywhere; color: var(--navy); font-size: .8rem; }
  .endpoint-card button { width: fit-content; padding: 0; border: 0; background: transparent; color: var(--seafoam-dark); cursor: pointer; font-family: inherit; font-size: .75rem; font-weight: 600; }
  .setup-list { border-top: 1px solid var(--navy); }
  .setup-list section { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .setup-label { color: var(--orange); font-size: .62rem; }
  .setup-list h3 { margin-top: 10px; }
  .setup-list pre, .contract-code pre { overflow-x: auto; margin: 18px 0 12px; padding: 17px; background: var(--midnight); }
  .setup-list pre code, .contract-code pre code { color: var(--seafoam-light); font-size: .73rem; }
  .setup-list p { margin: 0; font-size: .85rem; }
  .contract-section { background: var(--canvas); }
  .contract-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(48px, 8vw, 110px); align-items: start; }
  .contract-code { min-width: 0; background: var(--midnight); }
  .contract-code > div { display: flex; justify-content: space-between; gap: 20px; padding: 16px 20px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .contract-code > div span { color: var(--orange); font-size: .62rem; }
  .contract-code > div code { color: var(--seafoam-light); font-size: .7rem; }
  .contract-code pre { max-height: 580px; margin: 0; padding: 24px; }
  .boundary-section { background: var(--midnight); }
  .boundary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,.14); }
  .boundary-grid > div { padding: clamp(28px, 5vw, 56px); background: var(--midnight); }
  .boundary-grid span { color: var(--seafoam); font-size: .64rem; }
  .boundary-grid ul { margin: 34px 0 0; padding-left: 20px; color: rgba(255,255,255,.7); }
  .boundary-grid li { padding: 8px 0; }
  .api-section { background: var(--white); }
  .api-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .api-grid h2 { max-width: 680px; }
  .api-endpoint { margin: 0; }
  .built-section { background: linear-gradient(180deg, var(--canvas), rgba(68,180,139,.1)); }
  .built-card { display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(48px, 8vw, 100px); padding-block: 30px; }
  .built-card h2 { max-width: 800px; }
  .built-card p { max-width: 760px; font-size: 1.05rem; line-height: 1.7; }
  .built-card .actions { align-content: start; }
  .built-card .text-link { align-self: center; color: var(--seafoam-dark); font-size: .82rem; }
  @media (max-width: 820px) {
    .promise-grid, .connect-grid, .contract-grid, .boundary-grid, .api-grid, .built-card { grid-template-columns: 1fr; }
    .promise-grid > div, .promise-grid > div:last-child { border: 0; border-bottom: 1px solid var(--line); }
  }
</style>
